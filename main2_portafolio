# main2_portfolio.py
import pandas as pd
from datetime import datetime, timedelta
from utils.data_loader import get_data
from utils.trade_simulator import TradeSimulator
from utils.plot_utils import plot_equity_curve
from utils.portfolio_manager import PortfolioManager

# === Estrategias ===
from strategies.sma_strategy import sma_strategy
from strategies.rsi_strategy import rsi_strategy
from strategies.macd_strategy import macd_strategy
from strategies.bollinger_strategy import bollinger_strategy

print("🚀 Iniciando simulación de portafolio multi-estrategia...\n")

# ==========================================================
# 1️⃣ CONFIGURACIÓN INICIAL
# ==========================================================
SYMBOL = "AAPL"
INITIAL_CAPITAL = 10000
COMMISSION = 0.001

# Fechas (2 años de datos)
end = datetime.now()
start = end - timedelta(days=365 * 2)

# ==========================================================
# 2️⃣ CARGA DE DATOS
# ==========================================================
print(f"📡 Cargando datos de {SYMBOL} desde {start.date()} hasta {end.date()}...")
df = get_data(SYMBOL, start=start, end=end)

if df is None or df.empty:
    raise ValueError("❌ Error: no se pudieron cargar datos de mercado.")

print(f"✅ Datos cargados: {len(df)} registros.\n")


# ==========================================================
# 🧹 LIMPIEZA DE ÍNDICE (evita errores de duplicados)
# ==========================================================
if df.index.has_duplicates:
    print("⚠️ Se detectaron índices duplicados en los datos. Se eliminarán para evitar errores.\n")
    df = df[~df.index.duplicated(keep='first')]
    df = df.sort_index()


# ==========================================================
# 3️⃣ APLICAR ESTRATEGIAS
# ==========================================================
print("⚙️ Aplicando estrategias...\n")

strategies = {
    "SMA": sma_strategy(df.copy(), short=10, long=30),  
    "RSI": rsi_strategy(df.copy(), rsi_period=14, lower=30, upper=70),
    "MACD": macd_strategy(df.copy()),
    "Bollinger": bollinger_strategy(df.copy(), window=20, num_std=2)
}

# ==========================================================
# 4️⃣ EVALUAR DESEMPEÑO INDIVIDUAL
# ==========================================================
def calc_strategy_performance(df):
    # 🧹 Limpieza interna: elimina índices duplicados si los hay
    if df.index.has_duplicates:
        df = df[~df.index.duplicated(keep='first')]
        df = df.sort_index()

     # ⚙️ Asegurar que la columna 'Close' exista
    if "Close" not in df.columns:
        # Si la estrategia eliminó las columnas originales, tratamos de recuperarlas
        if "close" in df.columns:
            df.rename(columns={"close": "Close"}, inplace=True)
        else:
            print("⚠️ Estrategia sin columna 'Close'. Se omitirá en el cálculo de rendimiento.")
            return 0

    # Calcular retornos diarios
    returns = df["Close"].pct_change()

    # Detectar automáticamente columna de señal
    signal_col = None
    for col in ["Signal", "signal", "Position"]:
        if col in df.columns:
            signal_col = col
            break

    if signal_col is None:
        return 0  # Si no hay señal, no se puede calcular rendimiento

    # Calcular rendimiento estratégico
    strat_returns = returns * df[signal_col].shift(1)

    # Evitar errores por NaN o divisiones por cero
    if strat_returns.std() == 0 or strat_returns.std() is None:
        return 0

    sharpe = strat_returns.mean() / strat_returns.std() * (252 ** 0.5)
    return round(sharpe if pd.notna(sharpe) else 0, 3)

sharpe_scores = {name: calc_strategy_performance(data) for name, data in strategies.items()}
total_sharpe = sum(abs(v) for v in sharpe_scores.values())

weights = {k: abs(v) / total_sharpe if total_sharpe > 0 else 1/len(strategies)
           for k, v in sharpe_scores.items()}

print("📊 Ponderaciones iniciales por rendimiento (Sharpe Ratio):")
for name, w in weights.items():
    print(f"   {name:<10} → {w*100:.1f}% (Sharpe: {sharpe_scores[name]:.2f})")

# ==========================================================
# 5️⃣ CONFIGURAR SIMULADOR Y PORTAFOLIO
# ==========================================================
sim = TradeSimulator(initial_capital=INITIAL_CAPITAL, commission=COMMISSION)
portfolio = PortfolioManager(strategies=strategies, simulator=sim)
portfolio.update_weights(weights)
portfolio.allocate_cash()

# ==========================================================
# 6️⃣ LOOP DE PAPER TRADING MULTIESTRATEGIA
# ==========================================================
print("\n📈 Ejecutando operaciones combinadas...\n")

# --- Verificación temporal de señales generadas por cada estrategia ---
print("\n🔍 Verificando señales generadas por cada estrategia:")
for name, df in strategies.items():
    if "signal" in df.columns:
        print(f"{name}: señales únicas -> {df['signal'].unique()[:10]}")
    else:
        print(f"{name}: ⚠️ no tiene columna 'signal' en su DataFrame")
print("-----------------------------------------------------------\n")
# ---------------------------------------------------------------------

for i in range(1, len(df)):
    price = df["Close"].iloc[i]
    signals = {name: strat.iloc[i]["Signal"] if "Signal" in strat.columns else strat.iloc[i]["signal"]
               for name, strat in strategies.items()}

    # 🧩 Depuración: ver si hay alguna señal activa en este punto
    if any(sig != 0 for sig in signals.values()):
        print(f"[{df.index[i]}] Precio: {price:.2f} | Señales activas: {signals}")

    portfolio.update_positions(price, signals)
    portfolio.update_all_equity(price)

# ==========================================================
# 7️⃣ RESULTADOS FINALES
# ==========================================================
summary = portfolio.summary()

print("\n📊 RESULTADOS FINALES DEL PORTAFOLIO")
print(f"Capital inicial:  ${summary['initial_capital']:.2f}")
print(f"Capital final:    ${summary['final_value']:.2f}")

# Calcular ganancia y porcentaje (por si no existen en summary)
profit = summary.get("final_value", 0) - summary.get("initial_capital", 0)
profit_pct = (profit / summary["initial_capital"]) * 100 if summary["initial_capital"] > 0 else 0

# Mostrar equity si existe
if summary.get("equity_history"):
    print(f"Ganancia total:   ${profit:.2f} ({profit_pct:.2f}%)")
    print(f"Último equity:    ${summary['equity_history'][-1]:.2f}")
else:
    print("⚠️ No hay historial de equity registrado durante la simulación.")

# Mostrar número de operaciones
trades = summary.get("trades", 0)
num_trades = len(trades) if isinstance(trades, (list, tuple)) else trades
print(f"Operaciones:      {num_trades}")

# Calcular drawdown (aunque no esté guardado en summary)
max_dd = portfolio.calculate_drawdown() if hasattr(portfolio, "calculate_drawdown") else None
print(f"Drawdown máximo:  {max_dd:.2f}%" if max_dd is not None else "Drawdown máximo:  N/A")

# Mostrar posiciones abiertas
positions = summary.get("positions", {})
print(f"Posiciones abiertas: {len(positions)}")

# ==========================================================
# 8️⃣ GUARDAR Y GRAFICAR
# ==========================================================
pd.DataFrame(portfolio.equity_history, columns=["Equity"]).to_csv("outputs/csv/portfolio_equity.csv", index=False)
print("\n💾 Historial del portafolio guardado en: outputs/csv/portfolio_equity.csv")

plot_equity_curve(pd.DataFrame({"Equity": portfolio.equity_history}), title="Evolución del Portafolio Combinado")

print("\n✅ Simulación completada con éxito.")
